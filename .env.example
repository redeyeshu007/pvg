# ==============================================================================
# Pavan Vela Grand (PVG) — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local testing.
# In Render, configure these environment variables directly in the Render Dashboard:
# Dashboard -> Your Web Service -> Environment -> Environment Variables.
#
# NEVER commit .env, .env.local, or real SMTP credentials to version control.
# ==============================================================================

# Site URLs & Indexing
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_INDEXING=false

# Frontend API Base URL (Optional)
# ------------------------------------------------------------------------------
# Leave blank or omit when frontend & backend share the same Render Web Service (same-origin).
# Set to "https://api.yourdomain.com" or the Render backend URL if frontend is hosted separately.
NEXT_PUBLIC_API_URL=

# CORS Configuration (Backend)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Defaults to same-origin if omitted.
# Example: https://pavanvelagrand.com,https://pavan-vela-grand.onrender.com
CORS_ALLOWED_ORIGINS=

# SMTP Server & Email Delivery Configuration
# ------------------------------------------------------------------------------
# Required for functional booking enquiry dispatch to hotel administration.
# Support for Gmail App Passwords, Zoho Mail, SendGrid, Amazon SES, or custom cPanel SMTP.

# SMTP Hostname (e.g., smtp.gmail.com, smtppro.zoho.in, smtp.sendgrid.net)
SMTP_HOST=smtp.example.com

# SMTP Port: 587 (STARTTLS, recommended) or 465 (implicit TLS)
SMTP_PORT=587

# SMTP Secure: Set to "true" for port 465, "false" for port 587
SMTP_SECURE=false

# SMTP Username / Login account
SMTP_USER=reservations@pavanvelagrand.com

# SMTP Password / Provider App Password (NEVER commit real password)
SMTP_PASS=your_smtp_app_password_here

# Administrator Destination Email (receives all guest enquiries)
ADMIN_EMAIL=admin@pavanvelagrand.com

# Verified Sender Address (MUST match SMTP provider permitted sender)
MAIL_FROM="Pavan Vela Grand Reservations" <reservations@pavanvelagrand.com>
