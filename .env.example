# Pavan Vela Grand (PVG) - Environment Configuration Template
# Copy this file to .env.local for local development.

# Canonical Site URL
# - Local development: http://localhost:3000
# - Production deployment: https://your-production-domain.com (update when domain is provisioned)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search Engine Indexing Control
# - Set to "false" on local development, staging, and preview deployments to prevent search indexing.
# - Set to "true" ONLY on production with a verified domain to allow search engine indexing.
NEXT_PUBLIC_ALLOW_INDEXING=false
